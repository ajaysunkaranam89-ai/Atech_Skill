# HTTPS configuration. Copy to nginx/conf.d/default.conf after obtaining certificates
# (see docs/DEPLOYMENT.md §6) and replace atechskills.in with your domain.

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

upstream django {
    server web:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name atechskills.in www.atechskills.in;
    server_tokens off;
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name atechskills.in www.atechskills.in;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/live/atechskills.in/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/atechskills.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 2100m;
    client_body_timeout 600s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /static/ { alias /app/staticfiles/; expires 30d; add_header Cache-Control "public, immutable"; access_log off; }
    location /media/  { alias /app/media/; expires 1d; add_header X-Content-Type-Options nosniff always; }
    location /protected/ {
        internal;
        alias /app/private_media/;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /accounts/login/ {
        limit_req zone=login burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/conf.d/proxy_params.inc;
    }
    location / { include /etc/nginx/conf.d/proxy_params.inc; }
}
