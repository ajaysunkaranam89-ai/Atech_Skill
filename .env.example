# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=academy.example.com,www.academy.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://academy.example.com,https://www.academy.example.com
SITE_URL=https://academy.example.com
TIME_ZONE=Asia/Kolkata
# Set to 1 only after TLS certificates are installed in Nginx
HTTPS_ENABLED=0

# --- First Super Admin (created on first start only if it does not exist)
DJANGO_SUPERADMIN_EMAIL=owner@academy.example.com
DJANGO_SUPERADMIN_PASSWORD=CHANGE_ME_strong_password

# --- PostgreSQL
POSTGRES_DB=techskills
POSTGRES_USER=techskills
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Email (SMTP). Console backend prints emails to the web container log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=A TechSkills Academy <no-reply@academy.example.com>

# --- Razorpay (Dashboard > Settings > API Keys / Webhooks). Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Uploads
MAX_VIDEO_UPLOAD_MB=2048
MAX_DOCUMENT_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=5

# --- Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=600

# --- Published ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Security & reliability
# Staff (admins, course admins, trainers) must use an authenticator app. Keep 1 in production.
STAFF_2FA_REQUIRED=1
# Raw Django admin (/django-admin/): emergency use only
DJANGO_ADMIN_ENABLED=0
# Error reports: emailed to these people, and/or sent to Sentry if SENTRY_DSN is set
DJANGO_ADMINS=Academy Owner <owner@academy.example.com>
SENTRY_DSN=
# Nightly backups into ./backups (hour in TIME_ZONE)
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=0
